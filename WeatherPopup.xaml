<Window
    x:Class="LegendBar.WeatherPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lottie="using:CommunityToolkit.WinUI.Lottie">

    <Grid Background="Transparent">
        <Border CornerRadius="12"
                BorderThickness="0"
                Background="Transparent">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MainPanel"
                            Padding="20,16,20,20"
                            Spacing="16">

                    <!-- Header: City + DateTime -->
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="CityText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   FontFamily="Segoe UI"/>
                        <TextBlock x:Name="DateTimeText"
                                   FontSize="11"
                                   Foreground="#AAAAAA"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>

                    <!-- Main weather display -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Temp + condition -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="4">
                            <TextBlock x:Name="TempText"
                                       FontSize="52"
                                       FontWeight="Light"
                                       Foreground="White"
                                       FontFamily="Segoe UI"
                                       LineHeight="56"/>
                            <TextBlock x:Name="ConditionText"
                                       FontSize="13"
                                       Foreground="#CCCCCC"
                                       FontFamily="Segoe UI"/>
                            <TextBlock x:Name="FeelsLikeText"
                                       FontSize="11"
                                       Foreground="#888888"
                                       FontFamily="Segoe UI"/>
                        </StackPanel>

                        <!-- Lottie icon -->
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <AnimatedVisualPlayer x:Name="MainWeatherIcon"
                                                  Width="72"
                                                  Height="72"
                                                  AutoPlay="True"
                                                  Visibility="Collapsed"/>
                            <TextBlock x:Name="MainWeatherEmoji"
                                       FontSize="52"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Rectangle Height="1" Fill="#22FFFFFF"/>

                    <!-- Conditions grid -->
                    <Grid x:Name="ConditionsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2" Margin="0,0,0,12">
                            <TextBlock Text="HUMIDITY" FontSize="10" Foreground="#666666" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="HumidityText" FontSize="14" Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" Margin="0,0,0,12">
                            <TextBlock Text="WIND" FontSize="10" Foreground="#666666" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="WindText" FontSize="14" Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>

                        <!-- Row 1 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,0,0,12">
                            <TextBlock Text="UV INDEX" FontSize="10" Foreground="#666666" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UvText" FontSize="14" Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,0,0,12">
                            <TextBlock Text="PRECIPITATION" FontSize="10" Foreground="#666666" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PrecipText" FontSize="14" Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2" Margin="0,0,0,12">
                            <TextBlock Text="VISIBILITY" FontSize="10" Foreground="#666666" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VisibilityText" FontSize="14" Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="2" Margin="0,0,0,12">
                            <TextBlock Text="CLOUD COVER" FontSize="10" Foreground="#666666" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CloudText" FontSize="14" Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>

                        <!-- Row 3 -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2">
                            <TextBlock Text="SUNRISE" FontSize="10" Foreground="#666666" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SunriseText" FontSize="14" Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="2">
                            <TextBlock Text="SUNSET" FontSize="10" Foreground="#666666" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SunsetText" FontSize="14" Foreground="White" FontFamily="Segoe UI"/>
                        </StackPanel>

                    </Grid>

                    <!-- Divider -->
                    <Rectangle Height="1" Fill="#22FFFFFF"/>

                    <!-- 7-day forecast -->
                    <TextBlock Text="7-DAY FORECAST"
                               FontSize="10"
                               Foreground="#666666"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"/>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ForecastPanel"
                                    Orientation="Horizontal"
                                    Spacing="8"/>
                    </ScrollViewer>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>