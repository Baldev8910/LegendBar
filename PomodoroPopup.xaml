<Window
    x:Class="LegendBar.PomodoroPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <StackPanel Padding="20,16,20,20"
                    Spacing="14">

            <!-- Header -->
            <TextBlock Text="Pomodoro Timer"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       FontWeight="SemiBold"/>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#22FFFFFF"/>

            <!-- Buttons row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="StartButton"
                        Grid.Column="0"
                        Content="Start Focus"
                        HorizontalAlignment="Stretch"
                        Background="#4472C4"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="0,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        Click="Start_Click"/>

                <Button x:Name="SkipButton"
                        Grid.Column="2"
                        Background="#22FFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="8"
                        Padding="12,10"
                        FontSize="13"
                        FontWeight="SemiBold"
                        FontFamily="Segoe UI"
                        Click="Skip_Click">
                    <FontIcon Glyph="&#xE893;" FontSize="13" Foreground="White"/>
                </Button>

            </Grid>

            <!-- Focus -->
            <StackPanel Spacing="6">
                <TextBlock Text="FOCUS"
                           Foreground="#88FFFFFF"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="100"/>
                <Border x:Name="FocusBorder"
                        Background="#18FFFFFF"
                        CornerRadius="10"
                        Padding="0,10">
                    <TextBlock x:Name="FocusTimeText"
                               Text="45:00"
                               Foreground="White"
                               FontFamily="Segoe UI Mono"
                               FontSize="32"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Break -->
            <StackPanel Spacing="6">
                <TextBlock Text="BREAK"
                           Foreground="#88FFFFFF"
                           FontFamily="Segoe UI"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="100"/>
                <Border x:Name="BreakBorder"
                        Background="#18FFFFFF"
                        CornerRadius="10"
                        Padding="0,10">
                    <TextBlock x:Name="BreakTimeText"
                               Text="15:00"
                               Foreground="White"
                               FontFamily="Segoe UI Mono"
                               FontSize="32"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>

            <!-- Divider -->
            <Rectangle Height="1" Fill="#22FFFFFF"/>

        </StackPanel>
    </Grid>
</Window>