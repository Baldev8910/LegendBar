<Window
    x:Class="LegendBar.Popups.ReminderNotificationPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <Border x:Name="NotificationBorder"
                CornerRadius="12"
                BorderThickness="0"
                Padding="0"
                Background="Transparent"
                Opacity="0">
            <StackPanel Padding="20,16,20,16"
                        Spacing="12">

                <!-- Header row -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bell icon -->
                    <FontIcon Grid.Column="0"
                              Glyph="&#xEA8F;"
                              FontSize="16"
                              Foreground="White"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>

                    <!-- Title -->
                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Text="Reminder"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <!-- Dismiss button -->
                    <Button Grid.Column="2"
                            x:Name="DismissButton"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            VerticalAlignment="Center"
                            Click="Dismiss_Click">
                        <FontIcon Glyph="&#xE711;"
                                  FontSize="12"
                                  Foreground="White"
                                  Opacity="0.6"/>
                    </Button>
                </Grid>

                <!-- Divider -->
                <Rectangle Height="1" Fill="#22FFFFFF"/>

                <!-- Dismiss button full width -->
                <Button Content="Dismiss"
                        HorizontalAlignment="Stretch"
                        Background="#22FFFFFF"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="6"
                        Click="Dismiss_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
