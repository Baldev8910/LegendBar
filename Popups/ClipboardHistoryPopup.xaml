<Window
    x:Class="LegendBar.Popups.ClipboardHistoryPopup"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent"
          Margin="0,0,0,0">
        <Border CornerRadius="12"
                BorderThickness="0"
                Background="Transparent">
            <StackPanel Padding="20,16,20,20"
                        Spacing="12">

                <!-- Header row with Clear All -->
                <Grid>
                    <TextBlock Text="Clipboard History"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="ClearAllButton"
                            Content="Clear All"
                            HorizontalAlignment="Right"
                            Background="#22FFFFFF"
                            Foreground="#AAAAAA"
                            BorderThickness="0"
                            CornerRadius="6"
                            Padding="8,4"
                            FontSize="11"
                            Click="ClearAll_Click"/>
                </Grid>

                <!-- Divider -->
                <Rectangle Height="1" Fill="#22FFFFFF"/>

                <!-- Items -->
                <ScrollViewer MaxHeight="400"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ItemsPanel" Spacing="8"/>
                </ScrollViewer>

                <!-- Empty state -->
                <TextBlock x:Name="EmptyText"
                           Text="Nothing copied yet."
                           Foreground="#66FFFFFF"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Visibility="Collapsed"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>