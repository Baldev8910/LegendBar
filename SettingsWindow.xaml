<Window
    x:Class="LegendBar.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LegendBar Settings">

    <Grid>
        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar"
              Height="48"
              VerticalAlignment="Top">
            <TextBlock Text="LegendBar Settings"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>

        <!-- NavigationView -->
        <NavigationView x:Name="NavView"
                        Margin="0,48,0,0"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        ItemInvoked="NavView_ItemInvoked"
                        OpenPaneLength="220">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="SearchBox"
                                PlaceholderText="Search settings"
                                QueryIcon="Find"
                                TextChanged="SearchBox_TextChanged"
                                SuggestionChosen="SearchBox_SuggestionChosen"/>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AppearanceItem"
                                    Content="Appearance"
                                    Tag="Appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE771;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="WidgetsItem"
                                    Content="Widgets"
                                    Tag="Widgets">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF4C3;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="BehaviorItem"
                                    Content="Behavior"
                                    Tag="Behavior">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="PinsItem"
                                    Content="Pins"
                                    Tag="Pins">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE840;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem x:Name="ExtensionsItem"
                        Content="Extensions"
                        Tag="Extensions">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA86;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

                

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutItem"
                                    Content="About"
                                    Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Page content area -->
            <Frame x:Name="ContentFrame"/>

        </NavigationView>
    </Grid>
</Window>