<Page x:Class="LegendBar.Pages.BehaviorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Required">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">

            <!-- Page Title -->
            <TextBlock Text="Behavior"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <!-- Section: System -->
            <TextBlock Text="System"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,0,0,6"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Launch on Startup"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="StartupToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  MinWidth="0"
                                  Toggled="StartupToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Section: Animation -->
            <TextBlock Text="Animation"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,6"/>

            <!-- Show Speed -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Show Speed"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Slider x:Name="ShowSpeedSlider"
                            Grid.Column="1"
                            Minimum="50"
                            Maximum="500"
                            VerticalAlignment="Center"
                            ValueChanged="ShowSpeedSlider_Changed"/>
                    <TextBlock x:Name="ShowSpeedLabel"
                               Grid.Column="2"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Hide Speed -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Hide Speed"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Slider x:Name="HideSpeedSlider"
                            Grid.Column="1"
                            Minimum="50"
                            Maximum="500"
                            VerticalAlignment="Center"
                            ValueChanged="HideSpeedSlider_Changed"/>
                    <TextBlock x:Name="HideSpeedLabel"
                               Grid.Column="2"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Hide Delay -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Hide Delay"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Slider x:Name="HideDelaySlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="1000"
                            VerticalAlignment="Center"
                            ValueChanged="HideDelaySlider_Changed"/>
                    <TextBlock x:Name="HideDelayLabel"
                               Grid.Column="2"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Section: Units -->
            <TextBlock Text="Units"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,6"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Temperature Unit"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center">
                        <RadioButton x:Name="CelsiusRadio"
                                     Content="°C"
                                     GroupName="TempUnit"
                                     Checked="TempUnit_Changed"/>
                        <RadioButton x:Name="FahrenheitRadio"
                                     Content="°F"
                                     GroupName="TempUnit"
                                     Checked="TempUnit_Changed"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>