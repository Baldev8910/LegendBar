<Page x:Class="LegendBar.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Required">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">

            <!-- Page Title -->
            <TextBlock Text="About"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <!-- Section: App -->
            <TextBlock Text="App"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,0,0,6"/>

            <!-- App name + version -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="LegendBar"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="VersionLabel"
                               Grid.Column="1"
                               FontSize="13"
                               Opacity="0.6"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Framework -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Framework"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text=".NET 9 · Windows App SDK 2.0.1"
                               FontSize="13"
                               Opacity="0.6"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Section: Dependencies -->
            <TextBlock Text="Open Source"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,6"/>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="NAudio" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="3.0.0" FontSize="13" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="SharpVectors.Reloaded" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="1.8.5" FontSize="13" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Markdig" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="1.1.3" FontSize="13" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="WebView2" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="1.0.3965" FontSize="13" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Toast UI Editor" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="MIT" FontSize="13" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="KaTeX" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="MIT" FontSize="13" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Meteocons" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="MIT" FontSize="13" Opacity="0.6" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Section: Links -->
            <TextBlock Text="Links"
           FontSize="13"
           FontWeight="SemiBold"
           Opacity="0.6"
           Margin="4,16,0,6"/>

            <HyperlinkButton NavigateUri="https://baldev8910.github.io/LegendBar/"
                 HorizontalAlignment="Stretch"
                 HorizontalContentAlignment="Stretch"
                 Padding="0"
                 CornerRadius="8,8,0,0"
                 Margin="0,0,0,1">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8,8,0,0"
            Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                       Text="Release Notes"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <FontIcon Grid.Column="1"
                      Glyph="&#xE8A7;"
                      FontSize="13"
                      Opacity="0.6"
                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </HyperlinkButton>

            <HyperlinkButton NavigateUri="https://github.com/Baldev8910/LegendBar"
                 HorizontalAlignment="Stretch"
                 HorizontalContentAlignment="Stretch"
                 Padding="0"
                 CornerRadius="0,0,8,8"
                 Margin="0,0,0,1">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="0,0,8,8"
            Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                       Text="GitHub"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                        <FontIcon Grid.Column="1"
                      Glyph="&#xE8A7;"
                      FontSize="13"
                      Opacity="0.6"
                      VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </HyperlinkButton>

        </StackPanel>
    </ScrollViewer>
</Page>