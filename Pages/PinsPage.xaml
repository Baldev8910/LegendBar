<Page x:Class="LegendBar.Pages.PinsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Required">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">

            <!-- Page Title -->
            <TextBlock Text="Pins"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <!-- Section: Pinned Items -->
            <TextBlock Text="Pinned Apps &amp; Files"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,0,0,6"/>

            <!-- Add Pin button -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="Add a Pin"
                                   FontSize="13"/>
                        <TextBlock x:Name="PinCountLabel"
                                   FontSize="11"
                                   Opacity="0.5"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="AddPinButton"
                            Grid.Column="1"
                            Content="Browse"
                            VerticalAlignment="Center"
                            Click="AddPinButton_Click"/>
                </Grid>
            </Border>

            <!-- Pin list -->
            <StackPanel x:Name="PinListPanel" Spacing="1"/>

        </StackPanel>
    </ScrollViewer>
</Page>