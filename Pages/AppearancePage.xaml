<Page x:Class="LegendBar.Pages.AppearancePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Required">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">

            <!-- Page Title -->
            <TextBlock Text="Appearance"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <!-- Section: Bar -->
            <TextBlock Text="Bar"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,0,0,6"/>

            <!-- Bar Height -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    Margin="0,0,0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Bar Height"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Slider x:Name="HeightSlider"
                            Grid.Column="1"
                            Minimum="30"
                            Maximum="80"
                            TickFrequency="5"
                            VerticalAlignment="Center"
                            ValueChanged="HeightSlider_Changed"/>
                    <TextBlock x:Name="HeightLabel"
                               Grid.Column="2"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Section: Material -->
            <TextBlock Text="Material"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,6"/>

            <!-- Material Type -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Material Type"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="MaterialCombo"
                              Grid.Column="1"
                              MinWidth="160"
                              VerticalAlignment="Center"
                              SelectionChanged="MaterialCombo_Changed">
                        <ComboBoxItem Content="Acrylic" Tag="Acrylic"/>
                        <ComboBoxItem Content="Mica" Tag="Mica"/>
                        <ComboBoxItem Content="Mica Alt" Tag="MicaAlt"/>
                        <ComboBoxItem Content="Solid" Tag="Solid"/>
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Tint Color — Acrylic + Solid -->
            <Border x:Name="TintColorCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Tint Color"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="TintColorBox"
                             Grid.Column="1"
                             Width="120"
                             PlaceholderText="#141414"
                             VerticalAlignment="Center"
                             TextChanged="TintColorBox_Changed"/>
                </Grid>
            </Border>

            <!-- Acrylic Tint Opacity — Acrylic only -->
            <Border x:Name="AcrylicTintCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Tint Opacity"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Slider x:Name="TintSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            VerticalAlignment="Center"
                            ValueChanged="TintSlider_Changed"/>
                    <TextBlock x:Name="TintLabel"
                               Grid.Column="2"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Acrylic Blur — Acrylic only -->
            <Border x:Name="AcrylicBlurCard"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Margin="0,0,0,1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Blur Amount"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>
                    <Slider x:Name="LuminositySlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="100"
                            VerticalAlignment="Center"
                            ValueChanged="LuminositySlider_Changed"/>
                    <TextBlock x:Name="LuminosityLabel"
                               Grid.Column="2"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>