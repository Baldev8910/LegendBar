<Page x:Class="LegendBar.Pages.WidgetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Required">

    <ScrollViewer Padding="32,24,32,24"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">

            <!-- Page Title -->
            <TextBlock Text="Widgets"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Visibility"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,0,0,6"/>

            <!-- Media Player -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Media Player"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="MediaToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  Toggled="MediaToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Clock -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Clock"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="ClockToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  Toggled="ClockToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Date -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Date"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="DateToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  Toggled="DateToggle_Toggled"/>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>