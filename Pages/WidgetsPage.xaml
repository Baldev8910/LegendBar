<Page x:Class="LegendBar.Pages.WidgetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      NavigationCacheMode="Required">

    <ScrollViewer Padding="32,24,20,24"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">

            <!-- Page Title -->
            <TextBlock Text="Widgets"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <!-- Section: Left Side -->
            <TextBlock Text="Left"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,0,0,6"/>

            <!-- Pin Button -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pin Button" FontSize="13" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="PinButtonToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  MinWidth="0"
                                  Toggled="PinButtonToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Media Player -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Media Player" FontSize="13" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="MediaToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  MinWidth="0"
                                  Toggled="MediaToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Section: Right Side -->
            <TextBlock Text="Right"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,6"/>

            <!-- Pomodoro -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Pomodoro Timer" FontSize="13" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="PomodoroToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  MinWidth="0"
                                  Toggled="PomodoroToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- PowerToys -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PowerToys" FontSize="13" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="PowerToysToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  MinWidth="0"
                                  Toggled="PowerToysToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Quick Notes -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Quick Notes" FontSize="13" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="NotesToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  MinWidth="0"
                                  Toggled="NotesToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Clipboard -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Clipboard" FontSize="13" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="ClipboardToggle"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Margin="0"
                                  MinWidth="0"
                                  Toggled="ClipboardToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Date -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Date" FontSize="13" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="DateToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="0"
                      MinWidth="0"
                      Toggled="DateToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Weather -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0,0,8,8"
                    Padding="16,14"
                    Margin="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Weather" FontSize="13" VerticalAlignment="Center"/>
                                <ToggleSwitch x:Name="WeatherToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="0"
                      MinWidth="0"
                      Toggled="WeatherToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Section: Center -->
            <TextBlock Text="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.6"
                       Margin="4,16,0,6"/>

            <!-- Clock -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8,8,0,0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Clock" FontSize="13" VerticalAlignment="Center"/>
                    <ToggleSwitch x:Name="ClockToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Margin="0"
                      MinWidth="0"
                      Toggled="ClockToggle_Toggled"/>
                </Grid>
            </Border>

            <!-- Clock Format -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="16,14"
                    Margin="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Clock Format" FontSize="13"/>
                        <TextBlock x:Name="ClockFormatPreview"
                       FontSize="11"
                       Opacity="0.6"/>
                    </StackPanel>
                    <ComboBox x:Name="ClockFormatCombo"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  SelectionChanged="ClockFormatCombo_SelectionChanged">
                        <ComboBoxItem Content="HH:mm" Tag="HH:mm"/>
                        <ComboBoxItem Content="HH:mm:ss" Tag="HH:mm:ss"/>
                        <ComboBoxItem Content="h:mm tt" Tag="h:mm tt"/>
                        <ComboBoxItem Content="h:mm:ss tt" Tag="h:mm:ss tt"/>
                    </ComboBox>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>